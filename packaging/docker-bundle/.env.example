# .env.example — key structure for the RedpointAI docker bundle.
#
# `bun run build:bundle` bakes the REAL .env into the shipped zip from the
# operator's local (gitignored) root .env at build time — no real credentials
# live in this repo. This file documents the required keys and is what a rep
# edits to point the bundle at their own instance.

# --- Redpoint Interactions (RPI) MCP server ---
RPI_INTEGRATION_API_URL=https://<your-rpi-host>/
RPI_OAUTH_CLIENT_ID=<rpi-oauth-client-id>
RPI_OAUTH_CLIENT_SECRET=<rpi-oauth-client-secret>
RPI_PROXY_ENABLED=true
RPI_PROXY_USER=<rpi-service-user>
RPI_PROXY_PASS=<rpi-service-pass>
RPI_DEFAULT_CLIENT_ID=<rpi-client-id>
# Comma-separated RPI host domains allowed for the per-request "Environment Location" (X-RPI-URL). Empty = that feature is off (only RPI_INTEGRATION_API_URL is used).
RPI_URL_ALLOWLIST=
# Explicit SSO OIDC redirect_uri (the app's registered OAuth callback; vendor-neutral — id "sso", can front Keycloak/Entra/Okta). NON-secret. When set, the web app derives AUTH_URL from it so the redirect_uri sent to the IdP is deterministic (must match the IdP's registered value exactly); unset = derive from the request origin. Local: http://localhost:3001/api/auth/callback/sso. Prod: the hosted callback URL.
RPI_AI_AGENT_REDIRECT_URL=http://localhost:3001/api/auth/callback/sso
AUTH_REQUIRED=false

# --- LLM provider (Azure OpenAI shown; or instead set ANTHROPIC_API_KEY / OPENAI_API_KEY) ---
AZURE_OPENAI_API_KEY=<azure-openai-key>
AZURE_OPENAI_RESOURCE_NAME=<azure-resource-name>
AZURE_OPENAI_DEPLOYMENT_ID=<azure-deployment-id>
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AUTH_SECRET=<generate with: openssl rand -base64 32>

# --- Data Readiness Hub (DRH) MCP server ---
DRH_API_URL=https://<your-drh-host>/
# false force-disables the proxy user even if creds are set (else presence of user+pass enables it).
DRH_PROXY_ENABLED=true
DRH_PROXY_USER=<drh-proxy-user>
DRH_PROXY_PASS=<drh-proxy-pass>
DRH_DEFAULT_CLIENT_ID=<drh-client-id>
DRH_DEFAULT_DATABASE_ID=1

# --- Instrumentation (per-call usage capture: token/model counts) ---
INSTRUMENTATION_ENABLED=true                           # this bundle ships ON for the tester exercise — captures per-call token/model counts to the mounted host sink
INSTRUMENTATION_USER_ID=you@example.com                # this tester's identity — replace with your work email (unset collapses all container testers to one id)

# Fixed compose project name — down/up always target the same stack regardless of extract folder.
COMPOSE_PROJECT_NAME=redpointai

# =============================================================================
# ADVANCED — point at YOUR OWN instance
# Replace the values above with your own, then re-run start_redpoint-ai.bat.
#   RPI : RPI_INTEGRATION_API_URL, RPI_OAUTH_CLIENT_ID, RPI_OAUTH_CLIENT_SECRET,
#         RPI_DEFAULT_CLIENT_ID   (+ RPI_PROXY_USER / RPI_PROXY_PASS for a service acct)
#   DRH : DRH_API_URL, DRH_DEFAULT_CLIENT_ID, DRH_DEFAULT_DATABASE_ID
#         (+ DRH_PROXY_USER / DRH_PROXY_PASS)
#   LLM : AZURE_OPENAI_API_KEY / _RESOURCE_NAME / _DEPLOYMENT_ID / _API_VERSION
#         — or instead set  ANTHROPIC_API_KEY=...  or  OPENAI_API_KEY=...
# =============================================================================
