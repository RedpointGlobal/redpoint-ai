# --- Redpoint Interaction (RPI) MCP server ---
RPI_INTEGRATION_API_URL=https://rpi.your-company.com   # root URL of your RPI Integration API (no /api/v2 suffix)
RPI_OAUTH_CLIENT_ID=                                   # OAuth2 client credentials for the RPI /connect/token password grant
RPI_OAUTH_CLIENT_SECRET=
RPI_PROXY_ENABLED=true                                 # false force-disables the proxy user even if creds are set
RPI_PROXY_USER=                                        # native RPI service account — fallback when no per-user token is present
RPI_PROXY_PASS=
RPI_DEFAULT_CLIENT_ID=                                 # RPI tenant ID sent as X-ClientID (tool calls may override per-call)

# --- LLM provider (one required; seed precedence: Azure → Anthropic → OpenAI) ---
AZURE_OPENAI_API_KEY=                                  # the configured provider
AZURE_OPENAI_RESOURCE_NAME=your-resource-name
AZURE_OPENAI_DEPLOYMENT_ID=gpt-4.1                     # Azure deployment/model at runtime (read by pickDefaultProvider)
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# --- App auth ---
AUTH_REQUIRED=false                                    # true in production: callers must present a valid bearer token
AUTH_SECRET=                                           # JWT secret — generate with: openssl rand -base64 32

# --- Data Readiness Hub (DRH) MCP server ---
DRH_API_URL=https://your-drh-instance                  # DRH OP-ServicesAPI root. Also the provisioning switch: unset = no DRH card on the landing page
DRH_PROXY_USER=                                        # DRH service account — Keycloak signon fallback when no per-user token
DRH_PROXY_PASS=
DRH_DEFAULT_CLIENT_ID=                                 # required X-ClientId header (per-call override allowed)
DRH_DEFAULT_DATABASE_ID=                               # databaseId injected on database-scoped tools when the caller omits it

# --- Alternative LLM providers (placeholders — the seed picks by key presence: Azure → Anthropic → OpenAI) ---
# Provider and model come from this file; the seed rewrites each workspace on every boot — not UI-editable.
# ANTHROPIC_API_KEY=sk-ant-...                         # ANTHROPIC_MODEL overrides the model (default claude-sonnet-4-6)
# OPENAI_API_KEY=sk-...                                # OPENAI_MODEL overrides the model (default gpt-4o)
# GOOGLE_GENERATIVE_AI_API_KEY=...                     # wired in the provider factory but NOT env-selectable — needs a pickDefaultProvider code change
