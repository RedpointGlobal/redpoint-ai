# Required: At least one LLM provider API key.
# The seed picks the default workspace provider by key presence:
# Azure → Anthropic → OpenAI. Supply exactly one for a turnkey first run;
# if multiple are set, Azure wins (existing-install precedence). Provider
# and model are per-workspace and changeable in the UI afterward.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_RESOURCE_NAME=your-resource-name
# AZURE_OPENAI_DEPLOYMENT_ID=gpt-4.1         # used by scripts/accuracy-evaluation/ probe-pace; runtime model selection lives in workspace DB config
# AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Server
PORT=3000
AUTH_REQUIRED=false          # Set to "true" in production
AUTH_SECRET=                 # Required in production — generate with: openssl rand -base64 32

# OIDC (required if AUTH_REQUIRED=true and using JWT auth)
# OIDC_JWKS_URI=https://your-idp/.well-known/jwks.json
# OIDC_ISSUER=https://your-idp
# OIDC_AUDIENCE=redpoint-ai

# RPI MCP Server (point to your on-premises RPI instance)
RPI_INTEGRATION_API_URL=https://rpi.your-company.com

# OAuth2 client credentials for the RPI /connect/token password grant.
RPI_OAUTH_CLIENT_ID=
RPI_OAUTH_CLIENT_SECRET=

# Default value for the X-ClientID header (the RPI tenant/workspace ID).
# The agent reads this at startup to seed its current-client selection.
# The MCP server uses it as a fallback when a tool call doesn't carry an explicit clientId.
RPI_DEFAULT_CLIENT_ID=

MCP_HTTP_PORT=3002

# Optional proxy user — a native RPI service account used as a fallback
# when no per-user token is present on an incoming request.
# Setting RPI_PROXY_USER and RPI_PROXY_PASS implicitly enables the proxy.
# Set RPI_PROXY_ENABLED=false to force-disable it (credentials will be ignored).
# RPI_PROXY_USER=your-service-account-username
# RPI_PROXY_PASS=your-service-account-password
# RPI_PROXY_ENABLED=false

# OpenAPI spec for type generation (URL or file path — build-time only, not needed at runtime)
# RPI_OPENAPI_SPEC=https://<your-rpi-instance>/swagger/v1/swagger.json

# Web UI
NEXT_PUBLIC_API_URL=http://localhost:3000   # Used in dev. Docker compose falls back to http://server:3000 if unset.
# Next.js collects anonymous usage telemetry by default on `next build`/`next dev`.
# The Docker image sets this to 1; uncomment for local dev to opt out as well.
# NEXT_TELEMETRY_DISABLED=1

# Database
# DB_FILE_NAME sets the SQLite file path (dev/default). If unset, the server
# defaults to redpoint-ai.db alongside the server entry point (see db.ts).
# DB_FILE_NAME=redpoint-ai.db

# DATABASE_URL switches to PostgreSQL when set (production). Leave unset for SQLite.
# DATABASE_URL=postgres://redpoint:password@localhost:5432/redpoint_ai

# Logging
LOG_LEVEL=info

# A2A Inbound Server (optional — off by default)
# Enables other agents to call this agent over A2A JSON-RPC 2.0.
A2A_ENABLED=false
A2A_WORKSPACE_ID=
A2A_BEARER_TOKEN=
# A2A_PORT=4100
