# RedpointAI — environment template (generated from the tamed root .env by scripts/env-scopes.ts)
# Copy to .env and fill in your values. Secrets are 🔑 (shown empty here).
# #@scope: tags declare which artifact each block belongs to (hosted-app / mcp-rpi / mcp-drh / container).
# Regenerate with: bun run gen:env

#@scope: hosted-app, mcp-rpi, mcp-drh
# Universal auth gate. true = callers must present a valid token/session; false = dev/eval, no login required (calls run with the credentials configured in .env). Required by all three services.
AUTH_REQUIRED=true

#@scope: hosted-app
# JWT signing secret (NextAuth). REQUIRED when AUTH_REQUIRED=true — the server refuses to boot without a real one. Generate: openssl rand -base64 32.  (secret — leave empty here)
AUTH_SECRET=

# LLM provider API key (the configured Azure OpenAI provider). Required for the hosted app to run the agent.  (secret — leave empty here)
AZURE_OPENAI_API_KEY=

# Azure OpenAI resource name (the <name>.openai.azure.com host).
AZURE_OPENAI_RESOURCE_NAME=your-resource-name

# Azure deployment / model used at runtime.
AZURE_OPENAI_DEPLOYMENT_ID=gpt-4.1

# Azure OpenAI API version.
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Instrumentation: true = capture per-call token/model counts to a local JSONL sink; false = zero collection. Optional (default off).
INSTRUMENTATION_ENABLED=false

# Instrumentation tester identity (your work email); prod uses the Entra sub automatically. Optional.
INSTRUMENTATION_USER_ID=you@example.com

# Explicit SSO OIDC redirect_uri (the app's registered OAuth callback; vendor-neutral — id "sso", can front Keycloak/Entra/Okta). NON-secret. When set, the web app derives AUTH_URL from it so the redirect_uri sent to the IdP is deterministic (must match the IdP's registered value exactly); unset = derive from the request origin. Local: http://localhost:3001/api/auth/callback/sso. Prod: the hosted callback URL.
RPI_AI_AGENT_REDIRECT_URL=http://localhost:3001/api/auth/callback/sso

#@scope: container
# docker-compose only — NOT read by app code. Identity for the bundle launcher's container sweep (build:bundle hard-fails without it). Fixed value, not a secret.
COMPOSE_PROJECT_NAME=redpointai

#@scope: hosted-app, mcp-rpi
# RPI Integration API root URL (no /api/v2 suffix — the server appends it). Required for any RPI tool call.
RPI_INTEGRATION_API_URL=https://rpi.example.com

# OAuth2 client id for the RPI /connect/token password grant.
RPI_OAUTH_CLIENT_ID=

# OAuth2 client secret for the RPI /connect/token password grant.  (secret — leave empty here)
RPI_OAUTH_CLIENT_SECRET=

# RPI tenant id sent as the X-ClientID header (tool calls may override per-call).
RPI_DEFAULT_CLIENT_ID=

# Comma-separated RPI host domains allowed for the per-request "Environment Location" (X-RPI-URL). Empty = that feature is off (only RPI_INTEGRATION_API_URL is used).
RPI_URL_ALLOWLIST=

#@scope: mcp-rpi
# BYO native login — set RPI_PROXY_USER / RPI_PROXY_PASS to your OWN native RPI
# account. Every call is then attributed to you (your RBAC, your audit trail).
# Native-RPI users (isExternal:false) get per-user attribution via their own
# creds here. SSO-only users: use the OAuth/SSO path (AUTH_REQUIRED=true) instead
# — don't put SSO creds here. No native RPI login? Get one provisioned.
RPI_PROXY_ENABLED=true
RPI_PROXY_USER=
RPI_PROXY_PASS=

#@scope: hosted-app, mcp-drh
# DR Hub OP-ServicesAPI root URL. Also the provisioning switch: unset = no DRH card on the landing page.
DRH_API_URL=https://drh.example.com

#@scope: mcp-drh
# DRH tenant id sent as the X-ClientId header (per-call override allowed).
DRH_DEFAULT_CLIENT_ID=

# databaseId injected on database-scoped tools when the caller omits it. Optional.
DRH_DEFAULT_DATABASE_ID=

# Service-account (proxy) credentials — ONLY for unattended/automated runs (eval, CI).
# Interactive users leave these blank; your own login token is used instead.
# false force-disables the proxy user even if creds are set (else presence of user+pass enables it).
DRH_PROXY_ENABLED=true

# DRH service account — Keycloak signon fallback when no per-user token is present.
DRH_PROXY_USER=

# DRH service-account password.  (secret — leave empty here)
DRH_PROXY_PASS=

# --- Alternative LLM providers (placeholders — the seed picks by key presence: Azure -> Anthropic -> OpenAI) ---
# Provider and model come from this file; the seed rewrites each workspace on every boot.
# ANTHROPIC_API_KEY=sk-ant-...          # ANTHROPIC_MODEL overrides the model (default claude-sonnet-4-6)
# OPENAI_API_KEY=sk-...                 # OPENAI_MODEL overrides the model (default gpt-4o)
# GOOGLE_GENERATIVE_AI_API_KEY=...      # wired in the provider factory but NOT env-selectable
